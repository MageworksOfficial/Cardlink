CARDLINK_BIND=0.0.0.0
CARDLINK_PORT=8787
CARDLINK_RELAY_PORT=8788
CARDLINK_RELAY_HOST=play.example.com
CARDLINK_PROTOCOL=1
CARDLINK_CERT=/etc/cardlink/tls/fullchain.pem
CARDLINK_KEY=/etc/cardlink/tls/privkey.pem
CARDLINK_ROOM_TTL=90
CARDLINK_ROOM_MAX_AGE=14400
CARDLINK_MAX_ROOMS=32
CARDLINK_TRAFFIC_LIMIT=1073741824
CARDLINK_IDLE_TIMEOUT=30
